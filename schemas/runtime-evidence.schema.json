{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evidence_kind": {
      "enum": [
        "runtime",
        "mock"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "compiler_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "scenario_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "compilation": {
      "type": "object",
      "properties": {
        "target": {
          "enum": [
            "generic",
            "cursor",
            "claude",
            "codex"
          ]
        },
        "extract_sections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "target",
        "extract_sections"
      ],
      "additionalProperties": false
    },
    "compilation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recipe_sha256": {
      "type": "null"
    },
    "environment": {
      "type": "object",
      "properties": {
        "harness": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "harness_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "mode": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "mode_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "instrumentation_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "permission_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "cache_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "harness",
        "harness_version",
        "model",
        "model_version",
        "mode",
        "mode_version",
        "instrumentation_version",
        "permission_policy",
        "cache_policy",
        "configuration_id"
      ],
      "additionalProperties": false
    },
    "samples": {
      "type": "integer",
      "minimum": 2
    },
    "packages": {
      "type": "object",
      "properties": {
        "canonical": {
          "type": "object",
          "properties": {
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "minProperties": 1
            },
            "executable_files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "required": [
            "files",
            "executable_files"
          ],
          "additionalProperties": false
        },
        "compiled": {
          "type": "object",
          "properties": {
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "minProperties": 1
            },
            "executable_files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "required": [
            "files",
            "executable_files"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "canonical",
        "compiled"
      ],
      "additionalProperties": false
    },
    "static_metrics": {
      "type": "object",
      "properties": {
        "canonical_token_estimate": {
          "type": "integer",
          "minimum": 0
        },
        "compiled_root_token_estimate": {
          "type": "integer",
          "minimum": 0
        },
        "compiled_normal_path_token_estimate": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "canonical_token_estimate",
        "compiled_root_token_estimate",
        "compiled_normal_path_token_estimate"
      ],
      "additionalProperties": false
    },
    "passed": {
      "type": "boolean"
    },
    "observations": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "sample": {
            "type": "integer",
            "minimum": 1
          },
          "variant": {
            "enum": [
              "canonical",
              "compiled"
            ]
          },
          "session_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "observation": {
            "type": "object",
            "properties": {
              "turns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "invoked": {
                      "type": "boolean"
                    },
                    "output": {
                      "type": "string"
                    },
                    "actions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "reference_loads": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  },
                  "required": [
                    "invoked",
                    "output",
                    "actions",
                    "reference_loads"
                  ],
                  "additionalProperties": false
                }
              },
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "latency_ms": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "turns",
              "input_tokens",
              "output_tokens",
              "latency_ms"
            ],
            "additionalProperties": false
          },
          "passed": {
            "type": "boolean"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "check_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "passed": {
                  "type": "boolean"
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "check_id",
                "passed",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "sample",
          "variant",
          "session_id",
          "observation",
          "passed",
          "checks"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "evidence_kind",
    "run_id",
    "created_at",
    "compiler_version",
    "scenario_id",
    "scenario_sha256",
    "source_sha256",
    "compilation",
    "compilation_sha256",
    "recipe_sha256",
    "environment",
    "samples",
    "packages",
    "static_metrics",
    "passed",
    "observations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessmith.dev/schemas/runtime-evidence.schema.json",
  "title": "runtime-evidence"
}
