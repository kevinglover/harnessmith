{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessmith.dev/schemas/v1/package-manifest.schema.json",
  "title": "Harnessmith compiled package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "compiler", "target", "source", "transformations", "metrics", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "compiler": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"const": "harnessmith"}, "version": {"type": "string", "minLength": 1}}
    },
    "target": {"enum": ["generic", "cursor", "claude", "codex"]},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "recipe": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "transformations": {"type": "array", "items": {"type": "object"}},
    "metrics": {"type": "object", "additionalProperties": {"type": "integer"}},
    "files": {
      "type": "object",
      "propertyNames": {"not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}},
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}
