{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "evidence_kind": {
      "enum": [
        "runtime",
        "mock"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "compiler_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "scenario_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recipe_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment": {
      "type": "object",
      "properties": {
        "harness": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "harness_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "mode": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "mode_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "instrumentation_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "permission_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "cache_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "harness",
        "harness_version",
        "model",
        "model_version",
        "mode",
        "mode_version",
        "instrumentation_version",
        "permission_policy",
        "cache_policy",
        "configuration_id"
      ],
      "additionalProperties": false
    },
    "samples": {
      "type": "integer",
      "minimum": 4
    },
    "packages": {
      "type": "object",
      "properties": {
        "canonical": {
          "type": "object",
          "properties": {
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "minProperties": 1
            },
            "executable_files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "required": [
            "files",
            "executable_files"
          ],
          "additionalProperties": false
        },
        "mandatory": {
          "type": "object",
          "properties": {
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "minProperties": 1
            },
            "executable_files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "required": [
            "files",
            "executable_files"
          ],
          "additionalProperties": false
        },
        "conditional": {
          "type": "object",
          "properties": {
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "minProperties": 1
            },
            "executable_files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "required": [
            "files",
            "executable_files"
          ],
          "additionalProperties": false
        },
        "router": {
          "type": "object",
          "properties": {
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "minProperties": 1
            },
            "executable_files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "required": [
            "files",
            "executable_files"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "canonical",
        "mandatory",
        "conditional",
        "router"
      ],
      "additionalProperties": false
    },
    "static_metrics": {
      "type": "object",
      "properties": {
        "mandatory": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "conditional": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "router": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      },
      "required": [
        "mandatory",
        "conditional",
        "router"
      ],
      "additionalProperties": false
    },
    "passed": {
      "type": "boolean"
    },
    "observations": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "sample": {
            "type": "integer",
            "minimum": 1
          },
          "session_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "observation": {
            "type": "object",
            "properties": {
              "turns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "invoked": {
                      "type": "boolean"
                    },
                    "output": {
                      "type": "string"
                    },
                    "actions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "reference_loads": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  },
                  "required": [
                    "invoked",
                    "output",
                    "actions",
                    "reference_loads"
                  ],
                  "additionalProperties": false
                }
              },
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "latency_ms": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "turns",
              "input_tokens",
              "output_tokens",
              "latency_ms"
            ],
            "additionalProperties": false
          },
          "passed": {
            "type": "boolean"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "check_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "passed": {
                  "type": "boolean"
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "check_id",
                "passed",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "strategy": {
            "enum": [
              "canonical",
              "mandatory",
              "conditional",
              "router"
            ]
          }
        },
        "required": [
          "sample",
          "session_id",
          "observation",
          "passed",
          "checks",
          "strategy"
        ],
        "additionalProperties": false
      }
    },
    "conditional_policies": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "optional",
          "when",
          "rationale"
        ],
        "properties": {
          "optional": {
            "const": true
          },
          "when": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "strategies": {
      "const": [
        "canonical",
        "mandatory",
        "conditional",
        "router"
      ]
    },
    "router_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "review_sha256",
        "semantic_changes"
      ],
      "properties": {
        "kind": {
          "const": "reviewed-semantic-redesign"
        },
        "review_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "semantic_changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "evidence_kind",
    "run_id",
    "created_at",
    "compiler_version",
    "scenario_id",
    "scenario_sha256",
    "source_sha256",
    "recipe_sha256",
    "environment",
    "samples",
    "packages",
    "static_metrics",
    "passed",
    "observations",
    "conditional_policies",
    "strategies",
    "router_review"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessmith.dev/schemas/runtime-comparison-v2.schema.json",
  "title": "Four-way reviewed-router experiment"
}
